# ---- Datasets ----------------------------------------------------
# Raw source data from NYC Open Data. Not versioned — the crash CSV
# alone is 567 MB, well over GitHub's 100 MB per-file limit.
# See README.md for download links.
*.csv
*.geojson
*.parquet
*.xlsx

# Exception: small derived output the app actually consumes. Path-agnostic
# because these have moved around; keep them committable wherever they land.
!**/complaints_scored.csv
!**/flood_sensors.csv

# Derived / cached artifacts. Note `data/` itself is NOT ignored — git does not
# descend into an ignored directory, which would make the exceptions above
# unreachable. The *.csv rule already covers everything large inside it.
*.pkl
*.graphml
data/geocode_cache.json

# ---- Secrets -----------------------------------------------------
# Supabase keys, Mapbox tokens
.env
.env.*
!.env.example

# ---- Node / Next.js ----------------------------------------------
node_modules/
.next/
out/
build/
.vercel/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-error.log*

# ---- Python ------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ---- OS / editor -------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
